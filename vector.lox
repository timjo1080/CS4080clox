//constructor
fun vector(x, y) {
  fun object(message) {
    //addition method
    fun add(other) {
      return vector(x + other("x"), y + other("y"));
    }

    // accessing vector coords
    if (message == "x") return x;
    if (message == "y") return y;

    if (message == "add") return add;
    print "unknown message";
  }

  return object;
}

var a = vector(1, 2);
print a("x");
print a("y");

var b = vector(3, 4);
print b("x");
print b("y");

var c = a("add")(b);
print c("x");
print c("y");